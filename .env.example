# CONFIGURACIÓN DEL PROVEEDOR DE IA
# Opciones disponibles: 'groq' (Recomendado/Gratis), 'ollama' (Local/Gratis), 'openai'
LLM_PROVIDER=groq
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.2


# API KEYS (Completa solo la clave del proveedor seleccionado)
# Groq: Consigue tu API key en https://console.groq.com
GROQ_API_KEY=gsk_tu_groq_api_key_aqui

# OpenAI: Consigue tu API key en https://platform.openai.com
OPENAI_API_KEY=tu_openai_api_key_aqui


# CONFIGURACIÓN DE MONGODB
# Si usas Docker localmente: mongodb://127.0.0.1:27017/
MONGODB_URI=mongodb://127.0.0.1:27017/
DB_NAME=guia_ciudadana_db
COLLECTION_NAME=conversations